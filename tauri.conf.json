{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Owlin Mod Menu",
  "version": "1.5.13",
  "identifier": "com.owlin.app",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self' data:"
    },
    "windows": [
      {
        "title": "Owlin Mod Menu",
        "width": 1050,
        "height": 700,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true
      }
    ]
  },
  "plugins": {
    "window-state": {
      "denylist": []
    }
  }
}
